{
    "name": "cresset/wick",
    "description": "An unconfigurable, Laravel Pint-style PHP formatter. Fetches a prebuilt Rust binary on demand; powered by Mago.",
    "type": "library",
    "license": "EUPL-1.2",
    "keywords": ["php", "formatter", "laravel", "pint", "code-style"],
    "homepage": "https://github.com/cresset-tools/wick",
    "authors": [
        { "name": "Jelle Besseling", "email": "jelle@pingiun.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-curl": "Faster, more reliable binary downloads",
        "ext-zip": "Required to install on Windows (the binary ships as a .zip)"
    },
    "bin": ["bin/wick"],
    "extra": {
        "bougie": {
            "native-binary": {
                "spec": 1,
                "name": "wick",
                "tag-prefix": "wick-v",
                "base-urls": [
                    "https://releases.bougie.tools/github/wick/releases/download",
                    "https://github.com/cresset-tools/wick/releases/download"
                ],
                "targets": [
                    "x86_64-unknown-linux-gnu",
                    "x86_64-unknown-linux-musl",
                    "aarch64-apple-darwin",
                    "x86_64-pc-windows-msvc"
                ],
                "sigstore": {
                    "repository": "cresset-tools/wick"
                }
            }
        }
    }
}
